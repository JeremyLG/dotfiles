animations {
    // ─── Animations (migrated from Hyprland) ───
    // Hyprland animations:
    // - global: speed 3, bezier "quick"
    // - windows: speed 3, spring "easy", style "slide"
    // - workspaces: speed 5, bezier "quick", style "slide"
    // - specialWorkspace: speed 2, bezier "quick", style "slide top/bottom"

    // Hyprland bezier curves:
    // - quick: bezier(0.15, 0, 0.1, 1)
    // - easeOutQuint: bezier(0.23, 1, 0.32, 1)

    // Hyprland springs:
    // - easy: spring(mass=1, stiffness=500, dampening=35)

    // Note: Niri uses spring animations primarily, with some duration-based
    // The migration tries to approximate Hyprland's feel

    // Similar to Hyprland's workspace switching (speed 5, bezier quick)
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    // Similar to Hyprland's window animations (speed 3, spring easy)
    window-open {
        spring damping-ratio=0.9 stiffness=500 epsilon=0.001
    }

    window-close {
        spring damping-ratio=0.95 stiffness=550 epsilon=0.001
    }

    // Horizontal scrolling through columns/workspaces
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    // Window movement within workspace
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // Window resizing
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    // Config notifications (niri-specific)
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }

    // Screenshot UI
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    // Overview mode
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    // Custom spring for slow, smooth animations (like Hyprland's "easy" spring)
    // slowdown {
    //     spring damping-ratio=0.8 stiffness=400 epsilon=0.001
    // }
}
