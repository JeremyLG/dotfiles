// ────────────── Window Rules (migrated from Hyprland) ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules

// ─── Global settings ───
window-rule {
    // Migrated decoration settings from Hyprland
    geometry-corner-radius 10 // Hyprland had rounding = 10
    clip-to-geometry true
}

// ─── Background blur effect ───
// Hyprland had: blur { size = 5, passes = 4, special = true }
window-rule {
    background-effect {
        blur true
        xray false
    }
}

// ─── Opacity settings (migrated from Hyprland decorations) ───
// Hyprland: active_opacity = 0.95, inactive_opacity = 0.85
window-rule {
    opacity 0.95
}

// ─── Floating Noctalia settings window ───
window-rule {
    match app-id="dev.noctalia.Noctalia"
    match app-id="dev.noctalia.Noctalia.Settings"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// ─── Firefox profiles ───
// Different Firefox profiles open in specific workspaces
// Note: Niri doesn't support "silent" workspace switching like Hyprland
window-rule {
    match app-id="firefox"
    // Default firefox behavior - no special rules
}

// ─── Picture-in-Picture ───
// Hyprland: floating, keep aspect ratio, 25% of smaller screen dimension
window-rule {
    match title=r#"^([Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture)(.*)$"#
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}

// ─── Gaming apps (Steam, games, etc.) ───
// Hyprland had special "gaming" workspace and fullscreen rules
window-rule {
    match app-id=r#"^(steam_app.*|gamescope)$"#
    // Cannot set to specific workspace in niri without custom logic
    // Consider using Mod+Shift+number to move to a gaming workspace
}

window-rule {
    match app-id="^steam$" title="^Friends List$"
    open-floating true
}

window-rule {
    match app-id="^steam$" title="^Launching...$"
    open-floating true
}

window-rule {
    match app-id="^steam$" title="^$"
    open-floating true
}

// ─── Terminal applications ───
// Opacity override for terminals (Hyprland had opacity = 1.0 override)
// Niri handles terminal transparency through the terminal's own settings
window-rule {
    match app-id=r#"^(kitty|ghostty|[Kk]onsole|Alacritty|gnome-terminal|xfce[0-9]?-terminal)$"#
    // Let terminals handle their own transparency
}

// ─── Media players ───
// Hyprland: opacity = 1.0 override for media players
window-rule {
    match app-id=r#"^(mpv|org.kde.haruna|.*plex.*|org\.kde\.gwenview|.*vlc.*)$"#
    // Full opacity for media
}

// ─── Browsers ───
// Hyprland: opacity = 1.0 override for firefox/zen
window-rule {
    match app-id=r#"^(firefox|zen)$"#
    // Full opacity for browsers
}

// ─── Calculator ───
window-rule {
    match app-id=r#"^(.*[Cc]alc.*)$"#
    open-floating true
    default-column-width { fixed 380; }
    default-window-height { fixed 600; }
}

// ─── File manager (Dolphin) ───
window-rule {
    match app-id="^org\\.kde\\.dolphin$"
    exclude title=r#"^(Moving.*|Create New.*|Extract.*|Compress.*|Copying.*|Progress.*|Configure.*|Properties.*|Choose\sApplication.*)$"#
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 720; }
}

// ─── Archive manager ───
window-rule {
    match app-id="^org\\.kde\\.ark$"
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

// ─── KDE utilities ───
window-rule {
    match app-id="^org\\.kde\\.keditfiletype$"
    open-floating true
}

// ─── Communication apps (Discord, Vesktop) ───
window-rule {
    match app-id=r#"^(vesktop|discord)$"#
    // No special rules, opens normally
}

// ─── Windows .exe files (Wine/Proton) ───
window-rule {
    match app-id=r#"^(.*\.exe)$"#
    open-floating true
}

// ─── Launchers ───
window-rule {
    match app-id=r#"^(.*[Ll]auncher.*)$"#
    open-floating true
}

// ─── System utilities ───
window-rule {
    match app-id=r#"^(kvantummanager|qt[56]ct|nwg-look)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(org.pulseaudio.pavucontrol|blueman-manager|nm-applet|nm-connection-editor)$"#
    open-floating true
}

window-rule {
    match title=r#"^(Winetricks.*|Protontricks.*)$"#
    open-floating true
}

// ─── File pickers and dialogs ───
window-rule {
    match title=r#"^(Open|Authentication Required|Add Folder to Workspace|Choose Files|Save As|Confirm to replace files|File Operation Progress)$"#
    open-floating true
}

window-rule {
    match title=r#"^(Open File)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^([Xx]dg-desktop-portal-gtk)$"#
    open-floating true
}

window-rule {
    match title=r#"^(File Upload|Choose wallpaper|Library)(.*)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(.*dialog.*)$"#
    open-floating true
}

window-rule {
    match title=r#"^(.*dialog.*)$"#
    open-floating true
}

window-rule {
    match app-id="^hyprland-share-picker$"
    open-floating true
}

// ─── Remote desktop ───
window-rule {
    match app-id=r#"^(xfreerdp|xfreerdp3)$"#
    // Opens tiled
}

// ─── Swash ───
window-rule {
    match app-id=r#"^(.*swash)$"# title="^Swash$"
    open-floating true
    default-column-width { fixed 550; }
    default-window-height { fixed 550; }
}

// ────────────── Layer Rules (for noctalia-shell) ──────────────

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

layer-rule {
    match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd|window-switcher)$"#
    background-effect {
        xray false
        blur true
    }
}
